# Vercel / Production Frontend Environment Variables
# In Vercel Project Settings -> Environment Variables, add:
#
# VITE_API_URL=https://your-backend.railway.app
#
# If left blank, the frontend will connect to local backend (http://localhost:8000)
# or automatically provide seamless interactive Demo Data when the backend is offline.
VITE_API_URL=http://localhost:8000
