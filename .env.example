# =============================================================================
# Enterprise Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# --- Application ---
APP_NAME="Enterprise Intelligence Platform"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars

# --- JWT ---
JWT_SECRET=change-this-jwt-secret-to-something-secure-and-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DATABASE_URL=postgresql+asyncpg://eip_user:eip_password@localhost:5432/enterprise_intelligence
DATABASE_SYNC_URL=postgresql://eip_user:eip_password@localhost:5432/enterprise_intelligence
POSTGRES_USER=eip_user
POSTGRES_PASSWORD=eip_password
POSTGRES_DB=enterprise_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- AI Providers ---
# Set AI_PROVIDER to: mock | gemini | openai | ollama
AI_PROVIDER=mock

# Gemini (Google AI)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Ollama (optional, for local LLMs)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Backend ---
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_APP_NAME="Enterprise Intelligence Platform"

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=pdf,docx,txt,csv,xlsx,xls,json

# --- Background Jobs ---
# Set to: memory | redis
JOB_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# --- Tableau ---
TABLEAU_SERVER_URL=https://your-tableau-server.com
TABLEAU_SITE=your-site
TABLEAU_WORKBOOK=enterprise-intelligence
TABLEAU_TOKEN_NAME=your-token-name
TABLEAU_TOKEN_VALUE=your-token-value
TABLEAU_DB_USER=tableau_readonly
TABLEAU_DB_PASSWORD=your-tableau-db-password

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Feature Flags ---
ENABLE_ML_MODELS=true
ENABLE_GEMINI_INSIGHTS=false
ENABLE_ENTITY_EMBEDDINGS=false
